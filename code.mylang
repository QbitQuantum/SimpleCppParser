// Пример шаблонного типа
// Это шаблоны из C++
// Где-то плачет разработчик на С++
/*
Я не уверен стоит ли поддерживать синтаксис function<T>
Но писать function<T, K, W, Z> проще, чем
function<using T, using K, using W, using Z>, хотя если сравнивать с С++
function<typename T, typename K, typename W, typename Z>
то у меня еще прилично я бы сказал
*/
template TemplateDescription =
    A, // // только тип
    using B = [string], // только тип
    template C = using A, // шаблоны
    pointer Delete = [void](var[T*] p), // только указатели
    var[int] E = 0 // литералы
;

template TemplateTab = TemplateTest;
struct <TemplateTab> Tab {}; // struct <using B = [string], var[int] E = 0> Tab {};
struct <using B = [string], var[int] E = 0> Tab2 {};
// Объявление переменной
var[const int] INDEX_INVALID = -1;

// Это POD - тип.
// Никаких методов кроме статических. Только данные и  только публичные
// Можно наследовать, но не может наследовать другие
// Либо иди пиши class и не страдай фигнёй
// Может быть шаблонным
struct StCacheName;
struct<T, K> StCacheName
{
public:
    var[const K] public_INDEX_INVALID = -1;
static:
    var[const int] static_INDEX_INVALID = -1;
    function[void] validata_field(var[int]);
}

// base link class
class OctetBaseLink;
// Объявление класса с наследованием
class OctetBaseLink : OctetBaseNode {

private:

    // async request class
    // Объявление внутреннего класса с наследованием
    class OctetBaseLinkRequest : TNetHTTPRequest {

    private:
        var[string] __link;
        var[OctetBaseLink*] __parent;

        // Объявление функций
        function[void] _eventerror(var[const TObject*],  var[string]);
    public:

        var[string] RequestTag;
        var[bool] Completed = false;

        function[void] Abort();

        constructor<T>[virtual, ovveride const, noexcept](var[T*], var[string] RequestTag, var[string] Link, var[ERequestObtainData], var[int] Argument = INDEX_INVALID);
        constructor(var[OctetBaseLink*]);
        destructor[virtual]();
    };

protected:

    // internal data
    function[bool] _start(var[LLinkWorkType], var[string]);

    var[TNetHTTPClient*] __client = nullptr, __asyncclient = nullptr;
    var[LLinkWorkType] __work = lwIdle;

    var[string] __host, __lastresult;

    var[int] 
        __contime = LinkConnection::timeout, 
        __restime = LinkResponse::timeout;

    // class init
    function[void] _init();

    // header methods
    function[void] _setheaders(var[TNetHTTPClient*], var[bool] State);

    // internal events
    function[void] _eventerror(var[const TObject*],  var[string]);
    function[void] _eventauth(var[const TObject*], var[TAuthTargetType] Target, var[string], var[string], var[string&], var[string], var[bool&], var[TAuthPersistenceType&]);

static:
    function[void] _eventexecute(var[const TObject*],  var[string]);

public:

    // variables
    var[string] DefaultLink, UpdateLink, UserIdent, MachineIdent;

    var[bool] LocalLinking = false, InputCache = false, OutputCache = false;

    // base network methods

    function[string] Read(var[string], var[int] Type = LinkType::critical)
    {
        var[int] Temp = -1;

        // Всё по умолчанию по ссылке. Всё.
        lambda[int] _LocalRead(var[int] Type) { }
        lambda<T, R>[int] _LocalRead(var[int] Type) { }
    };
    function[string] Cache(var[string] Link);
    function[void] Stop(var[string] RequestTag = "");
    function[bool] Write(var[string], var[string] Data, var[TStringStream*] Response = NULL);

    // properties
    property[TNetHTTPClient*] Client { write = __asyncclient };
    property[int] ConnectionTimeout { write = __contime };
    property[int] ResponseTimeout { write = __restime };

    constructor(
        var[TComponent*], 
        var[int] ConnectionTimeout = LinkConnection::timeout, 
        var[int] ResponseTimeout = LinkResponse::timeout, 
        var[int] ConnectionTimeoutAsync = LinkConnection::timeout_async, 
        var[int] ResponseTimeoutAsync = LinkResponse::timeout_async);
};

function[void] BaseRequest::Abort()  {
    __abort = default; // false
    var[const int] number = 1;
};

struct Basic
{
static:
    var[int] StaticBasic;
}
// Это шаблоны из C++
// [T /* По умолчанию имя типа */, K = Basic /* Имя типа по умолчанию */, W = 0 /* значение */]
class
    <T, using K = [Basic], var[int] W = 0>
Base {
public:
    // Здесь мы объявляем член данных (поле класса) с именем PublicBaseData типа T
    // В этом месте грамматика требует тип.
    // Она не позволяет здесь оказаться статической переменной
    // Это проверяется на уровне семантического анализа
    var[T] PublicBaseData;
    function[void] [virtual] PublicMethodBase(var[T] arg);
    function[void] [virtual] PublicTest()
    {
        // Здесь мы вызываем функцию с передачей аргумента
        // Значит тут должно быть точно статическое поле
        PublicMethodBase(K::StaticBasic);
    };
}

class Derived : public Base<int, std::string, 5> {

public:
    function[void] [override] PublicMethodBase();
    class Math {
    static:
        function[void]  PublicMethodBase();
    }
static:
    var[int] StaticData = 1;
    function[void] StaticMethodBase();

private:
    var[int] m_pivate = 1;

}

function<T, K>[void]  PublicMethodBase() { };

function[int] main () {
    
    var[Derived*] un = new Derived();

    PublicMethodBase<int, std::vector<int>>(); // текущий контекст -> глобальный
    Derived::StaticMethodBase();       // статический
    Derived::Math::PublicMethodBase(); // статический вложенного класса
    
    un.PublicMethodBase();           // Объект напрямую
    un->PublicMethodBase(2 + 2);     // виртуальный через указатель  
    
    while (un)
    {
        // Эквивалент C++: delete un;
        un = delete;
        un = nullptr;
    }

    /* Это аналог  do-while цикла */
    while (un) do
    {
        // Эквивалент C++: delete un;
        un = delete;
        un = nullptr;
    }

    try { } catch /* catch(...) */ { }
    try { } // catch(...) {}
    try { } catch (var[IOException*] object) { }

    return 0;
};